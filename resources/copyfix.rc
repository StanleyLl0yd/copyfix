#include "resource_ids.h"
#include "copyfix_version.h"
#include <winver.h>

IDI_COPYFIX_APP ICON "copyfix.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION COPYFIX_VERSION_MAJOR,COPYFIX_VERSION_MINOR,COPYFIX_VERSION_PATCH,0
 PRODUCTVERSION COPYFIX_VERSION_MAJOR,COPYFIX_VERSION_MINOR,COPYFIX_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Stanley Lloyd"
            VALUE "FileDescription", "CopyFix - Offline Clipboard Text Cleanup"
            VALUE "FileVersion", COPYFIX_VERSION_STR
            VALUE "InternalName", "CopyFix"
            VALUE "LegalCopyright", "Copyright (c) 2026 Stanley Lloyd"
            VALUE "OriginalFilename", "CopyFix.exe"
            VALUE "ProductName", "CopyFix"
            VALUE "ProductVersion", COPYFIX_VERSION_STR
            VALUE "Comments", "https://stanleyll0yd.github.io/apps/copyfix/"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
